# Copy this file to .env and fill it in. Never share your .env!
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-bot-application-id
GUILD_ID=your-discord-server-id

# ── /stats: SFTP login of the Minecraft host (same as the old HFQ bot) ──
LIFESTEAL_FTP_HOST=
LIFESTEAL_FTP_PORT=22
LIFESTEAL_FTP_USER=
LIFESTEAL_FTP_PASS=
LIFESTEAL_FTP_REMOTE_DIR=/plugins/HFQLeaderboards/export
LIFESTEAL_FTP_POLL_SECONDS=30

# Optional: RCON makes /connect links live instantly (otherwise after restart)
LIFESTEAL_RCON_HOST=
LIFESTEAL_RCON_PORT=25575
LIFESTEAL_RCON_PASSWORD=
